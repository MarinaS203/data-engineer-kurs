USE bootcamp.northern_star;

--Prvi zadatak
/*1. Za svaku sezonu prikažite ukupan broj utakmica, ukupan broj
postignutih golova i prosečan broj golova po utakmici.*/

SELECT
    season,
    count(*) as num_of_matches,
    sum(home_goals + away_goals) as num_of_goals,
    avg(home_goals + away_goals)
    from matches_flat
    group by season
    order by num_of_matches DESC;

--Drugi zadatak 
/*2. Za svaki stadion prikažite najmanju, najveću i prosečnu zabeleženu
posetu, kao i broj utakmica za koje je poseta poznata.*/

SELECT 
    stadium_name,
    max(attendance) as max_att,
    min(attendance) as min_att,
    avg(attendance) as avg_att,
    count(match_id)
    from matches_flat
    where attendance IS NOT NULL
    group by stadium_name
    order by max_att DESC;

--Treci zadatak
/*3. Prikažite sudije koje su sudile najmanje 10 utakmica i koje su
ukupno pokazale najmanje 20 žutih kartona. Prikažite ime sudije, broj
utakmica i ukupan broj žutih kartona.*/

select 
    referee_name,
    count(*) as num_of_matches,
    sum(home_yellow_cards + away_yellow_cards) as total_yellow_cards
    from matches_flat
    group by referee_name
    having num_of_matches>=10 and total_yellow_cards>=20
    order by total_yellow_cards desc;

--Cetvrti zadatak
/*4. Podelite utakmice prema ukupnom broju golova na kategorije Bez
golova (0), Malo golova (1 ili 2) i Mnogo golova (3 ili više). Prikažite
broj utakmica u svakoj kategoriji i najveći broj golova na utakmici u
toj kategoriji.*/

/*U ovom zadatku mi je problem bio što sam pozivala order by status, i svaki put je prijavljivalo grešku. 
Posle sam videla da mora da se i grupiše po case when. */
--Radi i bez zagrada oko uslova.

select 
        case when (home_goals + away_goals=0) then 'Bez golova'
        when (home_goals + away_goals=1 or home_goals + away_goals=2) then 'Malo golova'
        when (home_goals + away_goals>=3) then 'Mnogo golova'
        else 'Greska, null vrednost' 
        end as status,
        count(*) as num_of_matches,
        max(home_goals + away_goals) AS max_goals
    from matches_flat  
    group by case when home_goals+away_goals=0 then 'Bez golova'
        when (home_goals+away_goals=1 or home_goals+away_goals=2) then 'Malo golova'
        when home_goals+away_goals>=3 then 'Mnogo golova'
        else 'Greska, null vrednost' 
        end
        order by num_of_matches desc;
         
--Peti zadatak
/*5. Za svaki klub prikažite broj utakmica koje je odigrao kao domaćin,
broj pobeda kod kuće i broj poraza kod kuće. U rezultat uključite
samo klubove koji su kod kuće odigrali najmanje 10 utakmica.*/
--Ovo mi je bila mnogo zanimljiva nova ideja, to je ono što sam Vas pitala na kraju časa, koliko case-eva treba da ima. Zapravo je najelegantnije rešenje da se sumiraju case-evi. Zanima me da li ovo može da se uradi sa if/else i inkrementacijom unapred zadate vrednosti. (npr sum=0 na početku, i onda svaki put sum=sum+1)

select home_team,
    count(*) as total_matches,
    sum(case when home_goals>away_goals then 1
             else 0
        end) as home_wins,
    sum(case when home_goals<away_goals then 1
             else 0
        end) as home_loss
from matches_flat
group by home_team
having total_matches>=10
order by total_matches DESC;

--Sesti zadatak
/*6. Za svakog sudiju prikažite ukupan broj utakmica, broj utakmica u
kojima je pokazao bar jedan crveni karton i procenat takvih utakmica
u odnosu na sve utakmice koje je sudio.*/

select 
    referee_name,
    count(*) as total_num_of_matches,
    sum( case when home_red_cards+away_red_cards<>0 then 1
              else 0
              end
        ) as num_of_games_with_red_cards,
    round((num_of_games_with_red_cards*100)/total_num_of_matches,2) as percentage_of_red_cards
from matches_flat
group by referee_name
order by num_of_games_with_red_cards desc;

--Sedmi zadatak
/*7. Za svaku sezonu prikažite broj pobeda domaćina, broj nerešenih
utakmica i broj pobeda gostiju. Takođe prikažite procenat utakmica
koje su završene nerešenim rezultatom.*/

select  
    season,
    sum(case when home_goals>away_goals then 1
        else 0
        end) as num_of_home_wins,
    sum(case when home_goals<away_goals then 1
        else 0
        end) as num_of_away_wins,
    sum(case when home_goals=away_goals then 1
        else 0
        end) as num_of_draws,
        round((num_of_draws*100)/count(season),3) as percentage_of_draws 
        /*count(*) as tot_number_of_matches--ovo sam koristila za proveru, ima jedna null vrednost u rezultatima koja nije pokrivena ovim slucajevima, mogla bi da se pokrije dodavanjem jednog case when;
        namerno sam stavila count(season) umesto count(*) da izbegnem null vrednosti(iako one nisu u koloni season, vec negde u home_goals ili away_goals)*/
    from matches_flat
    group by season
    order by season asc;
    
